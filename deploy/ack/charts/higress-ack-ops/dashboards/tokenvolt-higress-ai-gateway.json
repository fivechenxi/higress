      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(higress_ai_tpot_milliseconds_bucket{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}[5m])))", "refId": "A"}],
      "title": "网关 TPOT P50",
