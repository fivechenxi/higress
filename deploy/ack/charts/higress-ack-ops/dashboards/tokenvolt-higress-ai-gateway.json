      "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.90, sum by (le) (rate(higress_ai_tpot_milliseconds_bucket{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}[5m])))", "refId": "A"}],
      "title": "网关 TPOT P90",
      "type": "stat"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4}, "id": 10, "panels": [], "title": "同模型厂商质量与排名", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "description": "默认按成功率降序；可点击任意列按 TTFT、TPOT、RPM 或 TPM 排名。429 超过合同容量时从厂商失败率中排除。",
      "fieldConfig": {
        "defaults": {"decimals": 2},
        "overrides": [
          {"matcher": {"id": "byName", "options": "成功率"}, "properties": [{"id": "unit", "value": "percentunit"}]},
          {"matcher": {"id": "byRegexp", "options": "/^TTFT|^TPOT/"}, "properties": [{"id": "unit", "value": "ms"}]},
          {"matcher": {"id": "byName", "options": "RPM"}, "properties": [{"id": "unit", "value": "reqpm"}]}
        ]
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 5},
      "id": 15,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "成功率"}]},
      "targets": [
        {"expr": "label_replace(tokenvolt:provider_model_success_ratio:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"成功率\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"},
        {"expr": "label_replace(tokenvolt:provider_model_ttft_milliseconds:p50_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"TTFT P50\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "B"},
        {"expr": "label_replace(tokenvolt:provider_model_ttft_milliseconds:p90_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"TTFT P90\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "C"},
        {"expr": "label_replace(tokenvolt:provider_model_tpot_milliseconds:p50_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"TPOT P50\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "D"},
        {"expr": "label_replace(tokenvolt:provider_model_tpot_milliseconds:p90_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"TPOT P90\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "E"},
        {"expr": "label_replace(tokenvolt:provider_model_logical_rpm:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"RPM\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "F"},
        {"expr": "label_replace(tokenvolt:provider_model_total_tpm:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"quality_metric\", \"TPM\", \"\", \"\")", "format": "time_series", "instant": true, "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "G"}
      ],
      "title": "厂商质量排行（模型 × 厂商）",
      "transformations": [{"id": "joinByLabels", "options": {"value": "quality_metric"}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
