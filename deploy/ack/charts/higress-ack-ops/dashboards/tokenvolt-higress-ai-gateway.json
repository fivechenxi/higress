        {"expr": "tokenvolt:provider_model_ttft_milliseconds:p90_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}", "legendFormat": "P90 {{ai_model}} · {{ai_provider}}", "refId": "B"},
