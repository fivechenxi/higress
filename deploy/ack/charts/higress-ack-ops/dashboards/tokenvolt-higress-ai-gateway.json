{
  "annotations": {"list": []},
  "description": "按模型查看网关整体质量，并在同一模型下比较各厂商的延迟、吞吐与可用性。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(tokenvolt:ai_rpm:rate5m{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"})", "refId": "A"}],
      "title": "模型请求 RPM",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.99}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "1 - sum(tokenvolt:ai_failures_per_second:rate5m{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}) / clamp_min(sum(tokenvolt:ai_requests_per_second:rate5m{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}), 0.000001)", "refId": "A"}],
      "title": "网关成功率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 2000}]}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(higress_ai_ttft_milliseconds_bucket{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}[5m])))", "refId": "A"}],
      "title": "网关 TTFT P50",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 250}]}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.90, sum by (le) (rate(higress_ai_ttft_milliseconds_bucket{ai_route=~\"$route\",ai_model=~\"$model\",ai_provider=~\"$provider\"}[5m])))", "refId": "A"}],
      "title": "网关 TTFT P90",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
