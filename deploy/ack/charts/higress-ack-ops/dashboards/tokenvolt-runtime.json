{
  "annotations": {"list": []},
  "description": "最近五分钟的模型与厂商实时运行状态。",
  "editable": true, "graphTooltip": 1, "id": null,
  "links": [{"title": "模型质量", "type": "link", "url": "/grafana/d/tokenvolt-model-quality"}, {"title": "请求明细", "type": "link", "url": "/grafana/d/tokenvolt-request-details"}, {"title": "基础监控", "type": "link", "url": "/grafana/d/tokenvolt-infrastructure"}],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"decimals": 2}, "overrides": [
        {"matcher": {"id": "byName", "options": "成功率"}, "properties": [{"id": "unit", "value": "percentunit"}]},
        {"matcher": {"id": "byRegexp", "options": "/^TTFT|^TPOT/"}, "properties": [{"id": "unit", "value": "ms"}]},
        {"matcher": {"id": "byName", "options": "RPM"}, "properties": [{"id": "unit", "value": "reqpm"}]}
      ]},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0}, "id": 1,
      "options": {"cellHeight": "sm", "footer": {"show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "RPM"}]},
      "targets": [
        {"expr": "label_replace(tokenvolt:provider_model_success_ratio:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"成功率\", \"\", \"\")", "instant": true, "refId": "A"},
        {"expr": "label_replace(tokenvolt:provider_model_logical_rpm:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"RPM\", \"\", \"\")", "instant": true, "refId": "B"},
        {"expr": "label_replace(tokenvolt:provider_model_total_tpm:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"TPM\", \"\", \"\")", "instant": true, "refId": "C"},
        {"expr": "label_replace(tokenvolt:provider_model_ttft_milliseconds:p50_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"TTFT P50\", \"\", \"\")", "instant": true, "refId": "D"},
        {"expr": "label_replace(tokenvolt:provider_model_ttft_milliseconds:p90_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"TTFT P90\", \"\", \"\")", "instant": true, "refId": "E"},
        {"expr": "label_replace(tokenvolt:provider_model_tpot_milliseconds:p50_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"TPOT P50\", \"\", \"\")", "instant": true, "refId": "F"},
        {"expr": "label_replace(tokenvolt:provider_model_tpot_milliseconds:p90_rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"TPOT P90\", \"\", \"\")", "instant": true, "refId": "G"}
        ,{"expr": "label_replace(tokenvolt:configured_provider_model:info{ai_model=~\"$model\",ai_provider=~\"$provider\"}, \"runtime_metric\", \"已配置\", \"\", \"\")", "instant": true, "refId": "H"}
      ],
      "title": "厂商实时运行状态（一个模型 × 厂商一行）",
      "transformations": [{"id": "joinByLabels", "options": {"join": ["ai_model", "ai_provider"], "value": "runtime_metric"}}], "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "unit": "reqpm"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (ai_model,ai_provider) (label_replace(label_replace(label_replace(rate(route_upstream_model_consumer_metric_llm_request_count[5m]), \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\")) * 60", "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"}
      ],
      "title": "RPM 趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (ai_model,ai_provider) (label_replace(label_replace(label_replace((rate(route_upstream_model_consumer_metric_input_token[5m]) + rate(route_upstream_model_consumer_metric_output_token[5m])) * 60, \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\"))", "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"}
      ],
      "title": "TPM 趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.90, sum by (le,ai_model,ai_provider) (label_replace(label_replace(label_replace(rate(higress_ai_ttft_milliseconds_bucket[5m]), \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\")))", "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"}
      ],
      "title": "TTFT P90 趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.90, sum by (le,ai_model,ai_provider) (label_replace(label_replace(label_replace(rate(higress_ai_tpot_milliseconds_bucket[5m]), \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\")))", "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"}
      ],
      "title": "TPOT P90 趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "max": 1, "min": 0, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}, "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "asc"}},
      "targets": [{"expr": "1 - sum by (ai_model,ai_provider) (label_replace(label_replace(label_replace(rate(route_upstream_model_consumer_metric_llm_failure_count[5m]), \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\")) / clamp_min(sum by (ai_model,ai_provider) (label_replace(label_replace(label_replace(rate(route_upstream_model_consumer_metric_llm_request_count[5m]), \"provider_id\", \"$1\", \"ai_provider\", \"(.+)\") * on (provider_id) group_left (public_ai_model,public_ai_provider) (tokenvolt:provider_model_identity:info{public_ai_model=~\"$model\",public_ai_provider=~\"$provider\"} @ end()), \"ai_model\", \"$1\", \"public_ai_model\", \"(.+)\"), \"ai_provider\", \"$1\", \"public_ai_provider\", \"(.+)\")), 0.000001)", "legendFormat": "{{ai_model}} · {{ai_provider}}", "refId": "A"}],
      "title": "成功率趋势", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never"}, "unit": "reqpm"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}, "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "tokenvolt:provider_5xx_rpm:rate5m{ai_provider=~\"$provider\"}", "legendFormat": "5xx {{ai_provider}}", "refId": "A"},
        {"expr": "tokenvolt:provider_model_429_rpm:rate5m{ai_model=~\"$model\",ai_provider=~\"$provider\"}", "legendFormat": "429 {{ai_model}} · {{ai_provider}}", "refId": "B"}
      ],
      "title": "5xx / 429", "type": "timeseries"
    }
  ],
  "refresh": "30s", "schemaVersion": 39, "tags": ["tokenvolt", "runtime"],
  "templating": {"list": [
    {"current": {}, "label": "Prometheus", "name": "datasource", "query": "prometheus", "refresh": 1, "type": "datasource"},
    {"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "$datasource"}, "definition": "label_values(tokenvolt:configured_provider_model:info, ai_model)", "includeAll": true, "label": "模型", "multi": true, "name": "model", "query": {"query": "label_values(tokenvolt:configured_provider_model:info, ai_model)", "refId": "model-variable"}, "refresh": 2, "sort": 1, "type": "query"},
    {"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "$datasource"}, "definition": "label_values(tokenvolt:configured_provider_model:info{ai_model=~\"$model\"}, ai_provider)", "includeAll": true, "label": "厂商", "multi": true, "name": "provider", "query": {"query": "label_values(tokenvolt:configured_provider_model:info{ai_model=~\"$model\"}, ai_provider)", "refId": "provider-variable"}, "refresh": 2, "sort": 1, "type": "query"}
  ]},
  "time": {"from": "now-1h", "to": "now"}, "timepicker": {}, "timezone": "browser",
  "title": "TokenVolt / 实时运行", "uid": "tokenvolt-runtime", "version": 1
}
